#!/usr/bin/env bash
# apm — 声明式 Arch 软件包管理器

set -euo pipefail
IFS=$'\n\t'

# 全局环境: 复用 func.sh 工具; user/user_home 定位目标用户（兼容 sudo 执行）;
# state_dir 存放互斥锁与审计日志（遵循 XDG 状态目录规范, 不污染仓库）
path=$(cd "$(dirname "$0")" && pwd)
. "$path/func.sh"

user=$(get_current_user)
user_home=$(getent passwd "$user" | cut -d: -f6)
state_dir="${XDG_STATE_HOME:-$user_home/.local/state}/apm"
audit_log="$state_dir/audit.log"

# 配置清单路径: 优先 apm.conf, 自动回退兼容 packages.conf (可由 -c/--config 覆盖)
if [ -f "$path/apm.conf" ] || [ ! -f "$path/packages.conf" ]; then
  config_file="$path/apm.conf"
else
  config_file="$path/packages.conf"
fi

# apply 解析后的命令行选项状态
opt_yes=0
opt_conf=0

# 清单 @include 引入的配置脚本执行清单（load_desired 填充, run_confd 消费）
conf_scripts=()
# 清单 @group 声明的包组名（load_desired 填充, cmd_sync 保留与导出排除用）
desired_groups=()

# 自动检测已安装的 AUR helper，未找到时默认 yay（可通过环境变量 APM_BACKEND 覆盖）
if [ -z "${APM_BACKEND:-}" ]; then
  for _helper in yay paru; do
    if command -v "$_helper" >/dev/null 2>&1; then
      APM_BACKEND="$_helper"
      break
    fi
  done
  APM_BACKEND="${APM_BACKEND:-yay}"
fi

# ---------------------------------------------------------------------------
# 基础工具
# ---------------------------------------------------------------------------

log_info()  { printf '\033[32m[INFO]\033[0m  %s\n' "$*"; }
log_warn()  { printf '\033[33m[WARN]\033[0m  %s\n' "$*" >&2; }
log_error() { printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2; }

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

confirm() {
  local prompt="$1" ans
  if [ "$opt_yes" -eq 1 ]; then
    return 0
  fi
  if [ ! -t 0 ]; then
    log_warn "no tty for confirmation, use --yes"
    return 1
  fi
  read -r -p "$prompt [y/N] " ans
  case "$ans" in
    y | Y | yes | YES | Yes) return 0 ;;
    *) return 1 ;;
  esac
}

audit() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$audit_log"
}

ensure_state() {
  mkdir -p "$state_dir"
  # 兼容 sudo 执行: 状态文件归属真实用户, 便于后续直接查看
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    chown -R "$SUDO_USER:" "$state_dir" 2>/dev/null || true
  fi
}

acquire_lock() {
  ensure_state
  # 锁挂到高编号 fd, flock 后随进程退出自动释放; -n 非阻塞, 占用即报错
  exec 9>"$state_dir/lock"
  if ! flock -n 9; then
    log_error "another apm instance is running ($state_dir/lock)"
    exit 1
  fi
}

# AUR helper 必须运行在普通用户环境（构建缓存/凭据在 $HOME 下, root 会构建出错）;
# 保留 SSH_AUTH_SOCK 供私有 AUR git 仓库的认证
run_as_user() {
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    local -a sudo_args=(-u "$SUDO_USER")
    [ -n "${SSH_AUTH_SOCK:-}" ] && sudo_args+=(--preserve-env=SSH_AUTH_SOCK)
    sudo "${sudo_args[@]}" "$@"
  else
    "$@"
  fi
}

# ---------------------------------------------------------------------------
# 期望状态: 解析清单
# ---------------------------------------------------------------------------

# 输出 "src pkg" 每行; src ∈ {repo, aur, conf, prepare}
# @include <path>: 引入包文件(.conf 递归解析)或配置脚本(.sh 登记执行);
# 支持文件/目录/glob（目录与 glob 按文件名排序展开）, 相对路径基于引入文件所在目录
# @prepare <path>: 只处理 .sh, 登记为准备脚本（安装前执行, 如源配置/密钥导入）
parse_manifest() {
  local -A _seen=()

  _walk() {
    local file="$1" canon src=repo line
    [ -f "$file" ] || return 0
    canon=$(realpath -m "$file")
    if [ -n "${_seen[$canon]:-}" ]; then
      return 0
    fi
    _seen[$canon]=1

    # read 带 || [ -n "$line" ] 以兼容文件末尾无换行符
    while IFS= read -r line || [ -n "$line" ]; do
      # 去内联注释(#/;)与首尾空白, 空行跳过
      line=${line%%#*}
      line=${line%%;*}
      line=$(trim "$line")
      [ -n "$line" ] || continue

      # 三类行: section 切换来源; @include 显式引入; 普通行输出 "src pkg"
      case "$line" in
        '['*']')
          case "$line" in
            '[AUR]' | '[aur]') src=aur ;;
            '[System]' | '[system]')
              log_warn "deprecated section [System], treating as [Pacman]"
              src=repo
              ;;
            *) src=repo ;;
          esac
          ;;
        '@include '*)
          _do_include "$(trim "${line#@include}")" "$(dirname "$file")" "$line"
          ;;
        '@prepare '*)
          _do_prepare "$(trim "${line#@prepare}")" "$(dirname "$file")" "$line"
          ;;
        '*'*)
          # 组声明: *<组名> 展开为成员参与对拍（组是官方仓库概念, 恒为 repo 源）
          printf 'group %s\n' "${line#\*}"
          ;;
        '@'*)
          log_warn "unknown directive (use '@include <path>' / '*<group-name>'): $line"
          ;;
        *)
          printf '%s %s\n' "$src" "$line"
          ;;
      esac
    done <"$file"
  }

  # 展开引入目标: 目录 → 其下全部 .conf/.sh（不递归, 排序）; 含通配符 → glob 展开; 文件 → 自身
  _do_include() {
    local target="$1" base="$2" origin="$3" f canon
    local -a files=()
    [[ "$target" == /* ]] || target="$base/$target"

    if [ -d "$target" ]; then
      while IFS= read -r -d '' f; do files+=("$f"); done < <(
        find "$target" -maxdepth 1 -type f \( -name '*.conf' -o -name '*.sh' \) -print0 | sort -z)
    else
      local had_nullglob=false
      shopt -q nullglob && had_nullglob=true
      shopt -s nullglob
      # 全局 IFS=$'\n\t', glob 展开不会拆散含空格的文件名; 展开结果按 LC_COLLATE 排序
      files=( $target )
      $had_nullglob || shopt -u nullglob
    fi

    if [ "${#files[@]}" -eq 0 ]; then
      log_warn "include not found: $origin"
      return 0
    fi

    for f in "${files[@]}"; do
      case "$f" in
        *.conf)
          _walk "$f"
          ;;
        *.sh)
          canon=$(realpath -m "$f")
          [ -n "${_seen[$canon]:-}" ] && continue
          _seen[$canon]=1
          printf 'conf %s\n' "$canon"
          ;;
        *)
          log_warn "include ignored (not .conf/.sh): $f"
          ;;
      esac
    done
  }

  # @prepare 仅处理 .sh, 输出 prepare 源; 支持目录/glob, 相对路径基于引入文件所在目录
  _do_prepare() {
    local target="$1" base="$2" origin="$3" f canon
    local -a files=()
    [[ "$target" == /* ]] || target="$base/$target"

    if [ -d "$target" ]; then
      while IFS= read -r -d '' f; do files+=("$f"); done < <(
        find "$target" -maxdepth 1 -type f -name '*.sh' -print0 | sort -z)
    else
      local had_nullglob=false
      shopt -q nullglob && had_nullglob=true
      shopt -s nullglob
      files=( $target )
      $had_nullglob || shopt -u nullglob
    fi

    if [ "${#files[@]}" -eq 0 ]; then
      log_warn "prepare not found: $origin"
      return 0
    fi

    for f in "${files[@]}"; do
      case "$f" in
        *.sh)
          canon=$(realpath -m "$f")
          [ -n "${_seen[$canon]:-}" ] && continue
          _seen[$canon]=1
          printf 'prepare %s\n' "$canon"
          ;;
        *) log_warn "prepare ignored (not .sh): $f" ;;
      esac
    done
  }

  local f
  for f in "$@"; do
    _walk "$f"
  done
}

# 展开组名列表为成员集合: 支持组嵌套, 防环; 预取所有组名避免逐成员 fork
expand_groups() {
  local -A _seen=() _all_groups=()
  while IFS= read -r g; do
    _all_groups[$g]=1
  done < <(pacman -Sg 2>/dev/null | sed 's/ .*//' | sort -u || true)
  _recurse() {
    local g="$1" m
    [ -n "${_seen[$g]:-}" ] && return 0
    _seen[$g]=1
    while IFS= read -r m || [ -n "$m" ]; do
      [ -n "$m" ] || continue
      if [ -n "${_all_groups[$m]:-}" ]; then
        _recurse "$m"
      else
        printf '%s\n' "$m"
      fi
    done < <(pacman -Sgq "$g" 2>/dev/null || true)
  }
  local g
  for g in "$@"; do
    _recurse "$g"
  done
}

load_desired() {
  local src pkg
  # 配置缺失时显式报错, 避免 parse_manifest 静默返回空 → 期望集合为空 → 全部包被判定待移除
  if [ ! -f "$config_file" ]; then
    log_error "config not found: $config_file"
    exit 1
  fi
  # 以包名为键去重; 全局 IFS 是 \n\t, 这里显式按空格切分 "src pkg"
  declare -A pkg_src=()
  conf_scripts=()
  prepare_scripts=()

  while IFS=' ' read -r src pkg; do
    [ -n "$pkg" ] || continue
    # @prepare 引入的准备脚本: 不参与包调和, 登记到准备清单
    if [ "$src" = prepare ]; then
      prepare_scripts+=("$pkg")
      continue
    fi
    # @include 引入的配置脚本: 不参与包调和, 登记到执行清单
    if [ "$src" = conf ]; then
      conf_scripts+=("$pkg")
      continue
    fi
    # @group 声明: 展开为成员参与对拍; 组名记录供 sync 保留与导出排除
    if [ "$src" = group ]; then
      desired_groups+=("$pkg")
      local m
      while IFS= read -r m || [ -n "$m" ]; do
        [ -n "$m" ] && pkg_src[$m]=repo
      done < <(expand_groups "$pkg")
      continue
    fi
    if [ -n "${pkg_src[$pkg]:-}" ]; then
      # 重复定义时优先级: repo > aur
      if [ "$src" = repo ] && [ "${pkg_src[$pkg]}" = aur ]; then
        log_warn "$pkg listed in both repo and aur, keeping repo"
        pkg_src[$pkg]=repo
      fi
      continue
    fi
    pkg_src[$pkg]=$src
  done < <(parse_manifest "$config_file")

  desired_repo=()
  desired_aur=()
  for pkg in "${!pkg_src[@]}"; do
    case "${pkg_src[$pkg]}" in
      aur) desired_aur+=("$pkg") ;;
      *) desired_repo+=("$pkg") ;;
    esac
  done

  # 组名兜底: 批量 pacman -Q 一次查明已装情况, 预取所有组名避免逐包 fork
  # 只对未安装的组名引导改用 *<组名> 声明
  local -a repo_pkgs=()
  local -A installed_map=() all_groups=()
  for pkg in "${!pkg_src[@]}"; do
    [ "${pkg_src[$pkg]}" = repo ] && repo_pkgs+=("$pkg")
  done
  while IFS=' ' read -r name _; do
    installed_map[$name]=1
  done < <(LC_ALL=C pacman -Q "${repo_pkgs[@]}" 2>/dev/null || true)
  while IFS= read -r g; do
    all_groups[$g]=1
  done < <(pacman -Sg 2>/dev/null | sed 's/ .*//' | sort -u || true)
  for pkg in "${repo_pkgs[@]}"; do
    if [ -z "${installed_map[$pkg]:-}" ] && [ -n "${all_groups[$pkg]:-}" ]; then
      log_warn "$pkg is a package group, not a package; use '*$pkg' to declare the group"
    fi
  done
}

# ---------------------------------------------------------------------------
# 实际状态: 以 pacman 数据库为唯一真相
# ---------------------------------------------------------------------------

load_installed() {
  # -Qe 包含 AUR 包, -Qem 只含 AUR 包; 两者取差即官方源显式包
  # 查询失败（数据库缺失等）按空集处理, 不中断流程
  local -a all_explicit=() foreign_explicit=()
  mapfile -t all_explicit < <(pacman -Qeq 2>/dev/null | sort -u || true)
  mapfile -t foreign_explicit < <(pacman -Qemq 2>/dev/null | sort -u || true)

  inst_repo=()
  inst_aur=()
  local f
  for f in "${foreign_explicit[@]}"; do
    inst_aur+=("$f")
  done
  while read -r f; do
    [ -n "$f" ] && inst_repo+=("$f")
  done < <(comm -23 <(printf '%s\n' "${all_explicit[@]:-}") \
                    <(printf '%s\n' "${foreign_explicit[@]:-}"))
}

# comm 要求输入有序; 空数组时 printf 会多出一个空行, 先剔除避免参与比较
print_sorted() {
  printf '%s\n' "$@" | sed '/^$/d' | sort -u
}

compute_diffs() {
  # comm -13: 仅第二文件(期望)有 → 待安装; comm -23: 仅第一文件(已装)有 → 待移除
  added_repo=()
  removed_repo=()
  added_aur=()
  removed_aur=()
  mapfile -t added_repo < <(comm -13 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${desired_repo[@]:-}"))
  mapfile -t added_aur < <(comm -13 <(print_sorted "${inst_aur[@]:-}") <(print_sorted "${desired_aur[@]:-}"))
  mapfile -t removed_repo < <(comm -23 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${desired_repo[@]:-}"))
  mapfile -t removed_aur < <(comm -23 <(print_sorted "${inst_aur[@]:-}") <(print_sorted "${desired_aur[@]:-}"))
}

print_diff() {
  local p
  # Legend: green "+" = install, red "-" = remove; "(repo)" = official repos, "(aur)" = AUR
  echo "Legend: green \"+\" = install, red \"-\" = remove; (repo) = official repos, (aur) = AUR"
  # 不用 "${arr[@]:-}": 空数组时它会展开成一个空串元素, 造成空包名假行;
  # compute_diffs 已确保四个数组一定存在, 直接展开即可
  for p in "${added_repo[@]}"; do printf '\033[32m+ %s\033[0m (repo)\n' "$p"; done
  for p in "${added_aur[@]}"; do printf '\033[32m+ %s\033[0m (aur)\n' "$p"; done
  for p in "${removed_repo[@]}"; do printf '\033[31m- %s\033[0m (repo)\n' "$p"; done
  for p in "${removed_aur[@]}"; do printf '\033[31m- %s\033[0m (aur)\n' "$p"; done
}

# ---------------------------------------------------------------------------
# 变更执行
# ---------------------------------------------------------------------------

# 一次 -Syu 完成全系统升级; 非 pacman 后端时同时刷新 AUR 数据库
# 命名 sysupgrade 避免与子命令 apm sync（导出清单）混淆
sysupgrade() {
  if [ "$APM_BACKEND" = pacman ]; then
    sudo pacman -Syu --noconfirm
  else
    run_as_user "$APM_BACKEND" -Syu --noconfirm
  fi
}

# 装前预检: 一次批量查询确认在已配置仓库中存在, 避免单个坏名字让整批事务失败
verify_repo_pkgs() {
  local found p
  found=$(LC_ALL=C pacman -Si "$@" 2>/dev/null | sed -n 's/^Name[[:space:]]*: //p') || true
  for p in "$@"; do
    if printf '%s\n' "$found" | grep -qx "$p"; then
      printf '%s\n' "$p"
    else
      log_warn "skip $p: not found in configured repos (typo, or belongs to [AUR]/third-party repo)"
    fi
  done
}

# repo/AUR 分两轮: 官方源走 pacman, 不经 AUR helper; --needed 保证幂等
install_repo_round() {
  [ "${#added_repo[@]:-}" -gt 0 ] || return 0
  local -a ok=()
  mapfile -t ok < <(verify_repo_pkgs "${added_repo[@]}")
  [ "${#ok[@]}" -gt 0 ] || return 0
  log_info "installing repo packages: ${ok[*]}"
  sudo pacman -S --noconfirm --needed "${ok[@]}"
}

# AUR 预检: 一次批量经 helper 查询包是否存在（仓库或 AUR）, 过滤上游删除/改名/拼错的包
verify_aur_pkgs() {
  local found p
  found=$(run_as_user env LC_ALL=C "$APM_BACKEND" -Si "$@" 2>/dev/null | sed -n 's/^Name[[:space:]]*: //p') || true
  for p in "$@"; do
    if printf '%s\n' "$found" | grep -qx "$p"; then
      printf '%s\n' "$p"
    else
      log_warn "skip $p: not found in AUR (removed or renamed upstream)"
    fi
  done
}

# 确保 AUR 后端可用: 优先 pacman -S (若有 cn 源), 降级走官方 AUR git clone + makepkg-bin 编译
ensure_aur_backend() {
  [ "$APM_BACKEND" != pacman ] || return 0
  if command -v "$APM_BACKEND" >/dev/null 2>&1; then
    return 0
  fi
  log_info "AUR helper ($APM_BACKEND) not found, attempting auto-install..."
  if sudo pacman -S --noconfirm "$APM_BACKEND" 2>/dev/null; then
    return 0
  fi
  if [ "$APM_BACKEND" = "yay" ] && command -v git >/dev/null 2>&1 && command -v makepkg >/dev/null 2>&1; then
    log_info "installing yay-bin via official AUR git clone & makepkg..."
    local tmpdir
    tmpdir=$(mktemp -d)
    if run_as_user git clone --depth=1 https://aur.archlinux.org/yay-bin.git "$tmpdir/yay-bin" 2>/dev/null; then
      (cd "$tmpdir/yay-bin" && run_as_user makepkg -si --noconfirm) || true
    fi
    rm -rf "$tmpdir"
  fi
  if ! command -v "$APM_BACKEND" >/dev/null 2>&1; then
    log_error "failed to auto-install AUR helper ($APM_BACKEND)"
    return 1
  fi
}

# AUR 包必须经 helper 安装; backend=pacman 时跳过并记录而非失败, 清单可跨后端使用
install_aur_round() {
  [ "${#added_aur[@]:-}" -gt 0 ] || return 0
  if [ "$APM_BACKEND" = pacman ]; then
    log_warn "backend=pacman, skipping AUR packages: ${added_aur[*]}"
    audit "apply: skipped AUR (backend=pacman): ${added_aur[*]}"
    return 0
  fi
  ensure_aur_backend || return 1
  local -a ok=()
  mapfile -t ok < <(verify_aur_pkgs "${added_aur[@]}")
  [ "${#ok[@]}" -gt 0 ] || return 0
  log_info "installing AUR packages: ${ok[*]}"
  run_as_user "$APM_BACKEND" -S --noconfirm --needed "${ok[@]}"
}

# 安全删除判定: Required By 列表中只要存在"不在本次移除集合内"的包
# （移除后仍存活的依赖者）, 就禁止删除, 防止破坏依赖链
removal_safe() {
  local pkg="$1" remove_set="$2" req r
  # LC_ALL=C 固定 "Required By" 字段名（zh_CN 下该标签是"依赖它"）;
  # 列表为空白分隔; read 补 || [ -n "$r" ] 以处理末行无换行符
  req=$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Required By[[:space:]]*:[[:space:]]*//p')
  if [ -z "$req" ] || [ "$req" = "None" ]; then
    return 0
  fi
  while IFS= read -r r || [ -n "$r" ]; do
    r=$(trim "$r")
    [ -n "$r" ] || continue
    if ! printf '%s\n' "$remove_set" | grep -qx "$r"; then
      return 1
    fi
  done < <(printf '%s\n' "$req" | tr '[:space:]' '\n')
  return 0
}

remove_round() {
  local -a all=() to_remove=()
  # 不用 "${arr[@]:-}" 合并: 空数组会展开出幻影空元素, 导致 pacman -Rns "" 失败
  if [ "${#removed_repo[@]}" -gt 0 ]; then all+=("${removed_repo[@]}"); fi
  if [ "${#removed_aur[@]}" -gt 0 ]; then all+=("${removed_aur[@]}"); fi
  [ "${#all[@]}" -gt 0 ] || return 0

  local remove_set pkg
  remove_set=$(printf '%s\n' "${all[@]}")
  for pkg in "${all[@]}"; do
    if removal_safe "$pkg" "$remove_set"; then
      to_remove+=("$pkg")
    else
      log_warn "keep $pkg (still required by kept packages)"
    fi
  done

  if [ "${#to_remove[@]}" -gt 0 ]; then
    log_info "removing: ${to_remove[*]}"
    # -Rns: 递归移除无主依赖并删除配置文件
    sudo pacman -Rns --noconfirm "${to_remove[@]}"
  fi
}

# 只执行清单经 @include 声明的脚本（按声明序）, 未声明的不执行;
# 用 source 而非 bash 执行: conf.d 脚本依赖主进程的 func.sh 函数与 $path 等变量;
# 包裹子 shell 防止脚本对环境(PATH/选项/cwd)的修改污染主进程
run_confd() {
  local script
  if [ "${#conf_scripts[@]}" -eq 0 ]; then
    log_warn "manifest references no conf scripts (try '@include conf.d/' in apm.conf)"
    return 0
  fi
  for script in "${conf_scripts[@]}"; do
    # set +e 保持"中途失败不中断、只看最终状态"的既有语义（子 shell 内）
    # shellcheck disable=SC1090
    if ! ( set +e; source "$script" ); then
      log_warn "$script failed, continuing..."
    fi
  done
}

# 执行 @prepare 声明的脚本（安装前前置步骤, 如源配置/密钥导入）;
# 准备步骤系基础环境构建, 失败时立即报错并中断流程, 防止带病继续执行安装
run_prepare() {
  local script
  if [ "${#prepare_scripts[@]}" -eq 0 ]; then
    return 0
  fi
  for script in "${prepare_scripts[@]}"; do
    log_info "running prepare script: $script"
    if ! ( set -e; source "$script" ); then
      log_error "prepare script failed: $script"
      return 1
    fi
  done
}

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------

cmd_apply() {
  opt_yes=0
  opt_conf=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y | --yes) opt_yes=1; shift ;;
      --conf) opt_conf=1; shift ;;
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done

  acquire_lock
  load_desired
  load_installed
  compute_diffs

  local total=$(( ${#added_repo[@]} + ${#added_aur[@]} + ${#removed_repo[@]} + ${#removed_aur[@]} ))
  if [ "$total" -eq 0 ]; then
    log_info "in sync: repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
    if [ "$opt_conf" -eq 1 ]; then
      run_confd
    fi
    return 0
  fi

  echo "== diff =="
  print_diff

  # 删除确认在变更前完成，拒绝则整体中止
  local n_removed=$(( ${#removed_repo[@]} + ${#removed_aur[@]} ))
  if [ "$n_removed" -gt 0 ]; then
    # 预览 pacman -Rns 的真实递归闭包（含孤儿依赖级联），而不只是候选计数
    local -a rem_preview=()
    if [ "${#removed_repo[@]}" -gt 0 ]; then rem_preview+=("${removed_repo[@]}"); fi
    if [ "${#removed_aur[@]}" -gt 0 ]; then rem_preview+=("${removed_aur[@]}"); fi
    log_info "pacman -Rns 实际将移除（含递归依赖）:"
    pacman -Rns --print "${rem_preview[@]}" 2>/dev/null | sed 's/^/  - /' || true
    if ! confirm "remove $n_removed package(s)?"; then
      audit "apply: aborted (removal declined)"
      log_error "aborted by user"
      return 1
    fi
  fi

  # 执行顺序: 确认 → 准备(prepare) → upgrade → 装 repo → 装 AUR → 删 → 审计 → 配置(conf.d)
  if ! run_prepare; then
    audit "apply: aborted (prepare script failed)"
    log_error "aborted due to prepare script failure"
    return 1
  fi

  local needs_upgrade=0
  [ "${#added_repo[@]}" -gt 0 ] && needs_upgrade=1
  if [ "${#added_aur[@]}" -gt 0 ] && [ "$APM_BACKEND" != pacman ]; then
    needs_upgrade=1
  fi
  if [ "$needs_upgrade" -eq 1 ]; then
    log_info "upgrading system before install"
    sysupgrade
  fi

  install_repo_round
  install_aur_round
  remove_round

  run_confd

  audit "apply: +repo(${#added_repo[@]}) +aur(${#added_aur[@]}) -repo(${#removed_repo[@]}) -aur(${#removed_aur[@]})"
  log_info "done"
}

cmd_diff() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done
  load_desired
  load_installed
  compute_diffs
  if [ $(( ${#added_repo[@]} + ${#added_aur[@]} + ${#removed_repo[@]} + ${#removed_aur[@]} )) -eq 0 ]; then
    log_info "in sync: repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
  else
    print_diff
  fi
}

cmd_status() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done
  load_desired
  load_installed
  compute_diffs
  echo "desired:      repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
  echo "installed:    repo=${#inst_repo[@]} aur=${#inst_aur[@]}"
  echo "pending:      +repo=${#added_repo[@]} +aur=${#added_aur[@]} -repo=${#removed_repo[@]} -aur=${#removed_aur[@]}"
}

cmd_upgrade() {
  acquire_lock
  log_info "upgrading with backend=$APM_BACKEND"
  sysupgrade
  audit "upgrade: system upgraded via $APM_BACKEND"
}

# 反向 reconcile: 以系统为真相重新生成配置清单（导出, 供迁移/重建清单用）
# 覆盖前确认, --yes 跳过
# @include 与 *组名 行原样保留置顶: 组文件/脚本/组声明是清单的声明性入口, 不能被导出冲掉
cmd_sync() {
  opt_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y | --yes) opt_yes=1; shift ;;
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done

  acquire_lock
  load_desired
  load_installed

  # 组声明已覆盖其成员, 导出时排除, 避免成员重复落入 [Pacman]
  local -a export_repo=() export_aur=() group_members=()
  if [ "${#desired_groups[@]}" -gt 0 ]; then
    mapfile -t group_members < <(expand_groups "${desired_groups[@]}" | sort -u)
  fi
  mapfile -t export_repo < <(comm -23 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${group_members[@]:-}"))
  mapfile -t export_aur < <(print_sorted "${inst_aur[@]:-}")

  local manifest="$config_file"
  if ! confirm "rewrite $manifest: repo=${#export_repo[@]} aur=${#export_aur[@]}? (@include lines kept, comments replaced)"; then
    audit "sync: aborted"
    log_error "aborted by user"
    return 1
  fi

  # 抽出原清单的 @include/*组名 行（组文件/脚本/组声明引用）, 重写后置顶保留
  local -a includes=()
  if [ -f "$manifest" ]; then
    mapfile -t includes < <(grep -E '^[[:space:]]*(@include|@prepare|\*)' "$manifest" || true)
  fi

  # 临时文件 + mv 原子写, 避免写一半留下损坏的清单
  local inc
  {
    printf '# generated by apm sync - edit freely, run "apm apply" to reconcile\n'
    if [ "${#includes[@]}" -gt 0 ]; then
      for inc in "${includes[@]}"; do printf '%s\n' "$inc"; done
      printf '\n'
    fi
    printf '[Pacman]\n'
    for p in "${export_repo[@]}"; do printf '%s\n' "$p"; done
    printf '\n[AUR]\n'
    for p in "${export_aur[@]}"; do printf '%s\n' "$p"; done
  } >"$manifest.tmp"
  mv "$manifest.tmp" "$manifest"

  audit "sync: exported repo=${#export_repo[@]} aur=${#export_aur[@]} to $manifest"
  log_info "$manifest rewritten: repo=${#export_repo[@]} aur=${#export_aur[@]}"
}

# 生成清单模板: 默认写 apm.conf（缺失时回退 packages.conf）; 已存在则拒绝（--force 覆盖）,
# 模板内置注释掉的 @include 候选, 取消注释即启用
cmd_gen() {
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --force) force=1; shift ;;
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done

  local manifest="$config_file"
  if [ -f "$manifest" ] && [ "$force" -eq 0 ]; then
    log_error "$manifest already exists (use --force to overwrite)"
    return 1
  fi
  # 生成到自定义路径时父目录可能不存在
  mkdir -p "$(dirname "$manifest")"

  cat >"$manifest" <<'EOF'
# apm 清单 — 期望状态声明; 修改后运行 apm apply 调和到系统
# 语法: [Pacman]/[AUR] 分节 + 每行一个包名; # 注释
# @include <path> 显式引入: .conf 递归解析为包, .sh 登记为配置脚本; 支持文件/目录/glob
#
# 包组候选（取消注释即启用, 需先创建对应文件）:
#@include apm.d/base.conf
#@include apm.d/desktop.conf
# 准备脚本（安装前执行, 如源配置/密钥导入）:
#@prepare pre.d/
# 配置脚本候选:
#@include conf.d/
# 包组声明候选: *组名 展开为成员参与对拍（无需创建文件, 组恒为 repo 源）:
#*xorg
#*fcitx5-im

[Pacman]
# 官方源包示例（取消注释即安装）:
#zsh
#git
#htop
#tmux
# 官方源包组示例（*组名 展开为成员参与对拍）:
#*gnome

[AUR]
# AUR 包示例（需 APM_BACKEND 为 yay/paru, 且已配置 archlinuxcn 源）:
#visual-studio-code-bin
#google-chrome
EOF
  log_info "generated $manifest"
}

# 环境引导: 校验网络 → 自动引导 AUR Helper → 系统初始升级
cmd_bootstrap() {
  acquire_lock
  if ! check_network; then
    log_error "network not connected"
    exit 1
  fi
  ensure_aur_backend
  sysupgrade
  audit "init: backend=$APM_BACKEND"
  log_info "init done, run 'apm a' (or 'apm apply') to reconcile"
}

cmd_conf() {
  acquire_lock
  load_desired
  run_confd
}

cmd_log() {
  local n="${1:-30}"
  [[ "$n" =~ ^[0-9]+$ ]] || n=30
  if [ ! -f "$audit_log" ]; then
    echo "no audit log yet"
    return 0
  fi
  tail -n "$n" "$audit_log"
}

cmd_install() {
  if [ -f "$path/installer.sh" ]; then
    exec "$path/installer.sh" "$@"
  else
    log_error "installer.sh not found in $path"
    return 1
  fi
}

usage() {
  cat <<EOF
apm — declarative Arch package manager

usage:
  apm <command> [options]       (默认: status)

  # 查看
  apm d | diff [-c <path>]              显示待变更
  apm st | stat | status [-c <path>]    期望 vs 已装摘要
  apm logs | history | log [n]          审计日志尾部 (默认 30 行)

  # 变更
  apm a | apply [-y] [--conf] [-c <path>]   调和清单与系统 (先打印 diff)
  apm s | sync [-y] [-c <path>]             导出已装包到清单
  apm new | gen [-f] [-c <path>]            生成清单模板 (拒绝覆盖)

  # 系统安装与维护
  apm ins | install [options]           Arch Linux 系统全新安装交互引导
  apm i | init | bootstrap              环境初始化 (网络 + AUR helper)
  apm up | update | upgrade             全系统升级 (repo + aur)
  apm run | exec | conf                 强制执行 conf.d 脚本
  apm help | -h | --help                显示帮助

options:
  -y, --yes     跳过确认 (删除 / 重写清单)
  -c, --config  指定清单路径 (默认: 脚本同目录 apm.conf)
  --conf        即使 in sync 也执行 conf.d 脚本

env:
  APM_BACKEND   pacman | yay | paru (默认: 自动检测, 兜底 yay)
EOF
}

main() {
  local cmd="${1:--h}"
  shift || true
  case "$cmd" in
    install | ins) cmd_install "$@" ;;
    apply | a) cmd_apply "$@" ;;
    diff | d) cmd_diff "$@" ;;
    status | st | stat) cmd_status "$@" ;;
    sync | s) cmd_sync "$@" ;;
    gen | new) cmd_gen "$@" ;;
    up | update | upgrade) cmd_upgrade ;;
    init | bootstrap | i) cmd_bootstrap ;;
    conf | run | exec) cmd_conf ;;
    log | logs | history) cmd_log "$@" ;;
    help | -h | --help) usage ;;
    *) usage; return 1 ;;
  esac
}

# main guard: 被 source 时只加载函数（便于单测）, 直接执行才运行
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
