#!/usr/bin/env bash
# apm — 声明式 Arch 软件包管理器

set -euo pipefail
IFS=$'\n\t'

# 全局环境
path=$(cd "$(dirname "$0")" && pwd)

# 配置清单路径: 默认 apm.conf (可由 -c/--config 覆盖)
config_file="$path/apm.conf"

# 清单 @post 引入的后置脚本执行清单（load_desired 填充, run_post 消费）
post_scripts=()
# 清单 @group 声明的包组名（load_desired 填充, cmd_sync 保留与导出排除用）
desired_groups=()
# 仅通过包组引入的包（load_desired 填充, compute_diffs 消费）
declare -A group_only_pkgs=()
# 系统中已安装的所有包，含依赖安装（load_installed 填充, compute_diffs 消费）
declare -A inst_all_map=()

# 自动检测已安装的 AUR helper，未找到时默认 yay（可通过环境变量 APM_BACKEND 覆盖）
if [ -z "${APM_BACKEND:-}" ]; then
  for _helper in yay paru; do
    if command -v "$_helper" >/dev/null 2>&1; then
      APM_BACKEND="$_helper"
      break
    fi
  done
  APM_BACKEND="${APM_BACKEND:-yay}"
fi

# ---------------------------------------------------------------------------
# 基础工具
# ---------------------------------------------------------------------------

log_info()  { printf '\033[32m[INFO]\033[0m  %s\n' "$*"; }
log_warn()  { printf '\033[33m[WARN]\033[0m  %s\n' "$*" >&2; }
log_error() { printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2; }

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

confirm() {
  local prompt="$1" ans
  if [ "$opt_yes" -eq 1 ]; then
    return 0
  fi
  if [ ! -t 0 ]; then
    log_warn "no tty for confirmation, use --yes"
    return 1
  fi
  read -r -p "$prompt [y/N] " ans
  case "$ans" in
    y | Y | yes | YES | Yes) return 0 ;;
    *) return 1 ;;
  esac
}

# 各子命令共享的选项解析; 每次调用重置选项状态
parse_opts() {
  opt_yes=0
  opt_scripts=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y | --yes) opt_yes=1; shift ;;
      --scripts) opt_scripts=1; shift ;;
      -c | --config)
        if [ $# -lt 2 ]; then
          log_error "option $1 requires an argument"
          return 1
        fi
        config_file="$2"
        shift 2
        ;;
      *) log_error "unknown option: $1"; return 1 ;;
    esac
  done
}

acquire_lock() {
  # XDG_RUNTIME_DIR 无效（不存在/不可写）时落到 /tmp, 避免失败重定向噪音
  local lock_file=/tmp/apm.lock
  if [ -d "${XDG_RUNTIME_DIR:-}" ] && [ -w "${XDG_RUNTIME_DIR:-}" ]; then
    lock_file="$XDG_RUNTIME_DIR/apm.lock"
  fi
  # 锁挂到高编号 fd, flock 后随进程退出自动释放; -n 非阻塞, 占用即报错
  exec 9>"$lock_file"
  if ! flock -n 9; then
    log_error "another apm instance is running"
    exit 1
  fi
}

# AUR helper 必须运行在普通用户环境（构建缓存/凭据在 $HOME 下, root 会构建出错）;
# 保留 SSH_AUTH_SOCK 供私有 AUR git 仓库的认证
run_as_user() {
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    local -a sudo_args=(-u "$SUDO_USER")
    [ -n "${SSH_AUTH_SOCK:-}" ] && sudo_args+=(--preserve-env=SSH_AUTH_SOCK)
    sudo "${sudo_args[@]}" "$@"
  else
    "$@"
  fi
}

# ---------------------------------------------------------------------------
# 期望状态: 解析清单
# ---------------------------------------------------------------------------

# 输出 "src pkg" 每行; src ∈ {repo, aur, post, pre}
# @pkg <path>: 引入包清单文件(.conf 递归解析), 不处理脚本;
# @post <path>: 登记后置脚本（安装后执行, 任意扩展名/无后缀）;
# @pre <path>: 登记前置脚本（安装前执行, 任意扩展名/无后缀）;
# 支持文件/目录/glob（目录与 glob 按文件名排序展开）, 相对路径基于引入文件所在目录
parse_manifest() {
  local -A _seen=()

  _walk() {
    local file="$1" canon src=repo line
    [ -f "$file" ] || return 0
    canon=$(realpath -m "$file")
    if [ -n "${_seen[$canon]:-}" ]; then
      return 0
    fi
    _seen[$canon]=1

    # read 带 || [ -n "$line" ] 以兼容文件末尾无换行符
    while IFS= read -r line || [ -n "$line" ]; do
      # 去内联注释(#/;)与首尾空白, 空行跳过
      line=${line%%#*}
      line=${line%%;*}
      line=$(trim "$line")
      [ -n "$line" ] || continue

      # 四类行: section 切换来源; 指令显式引入; 组声明; 普通行输出 "src pkg"
      case "$line" in
        '['*']')
          case "$line" in
            '[AUR]' | '[aur]') src=aur ;;
            *) src=repo ;;
          esac
          ;;
        '@pkg '*)
          _do_pkg "$(trim "${line#@pkg}")" "$(dirname "$file")" "$line"
          ;;
        '@post '*)
          _do_scripts post "$(trim "${line#@post}")" "$(dirname "$file")" "$line"
          ;;
        '@pre '*)
          _do_scripts pre "$(trim "${line#@pre}")" "$(dirname "$file")" "$line"
          ;;
        '*'*)
          # 组声明: *<组名> 展开为成员参与对拍（组是官方仓库概念, 恒为 repo 源）
          printf 'group %s\n' "${line#\*}"
          ;;
        '@'*)
          log_warn "unknown directive (use '@pkg' / '@post' / '@pre' / '*<group-name>'): $line"
          ;;
        *)
          printf '%s %s\n' "$src" "$line"
          ;;
      esac
    done <"$file"
  }

  # 展开指令引入目标为文件列表(NUL 分隔): 目录 → 按 find 谓词取文件; 文件/glob → nullglob 展开
  # 在进程替换子 shell 执行, shopt 设置不外泄, 无需保存恢复
  _expand_target() {
    local target="$1" base="$2"
    shift 2
    [[ "$target" == /* ]] || target="$base/$target"
    if [ -d "$target" ]; then
      find "$target" -maxdepth 1 -type f "$@" -print0 | sort -z
    else
      shopt -s nullglob
      printf '%s\0' $target
    fi
  }

  # @pkg 展开引入目标: 目录 → 其下全部 .conf（不递归, 排序）; 含通配符 → glob 展开; 文件 → 自身
  _do_pkg() {
    local target="$1" base="$2" origin="$3" f
    local -a files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(
      _expand_target "$target" "$base" -name '*.conf')

    if [ "${#files[@]}" -eq 0 ]; then
      log_warn "pkg not found: $origin"
      return 0
    fi

    for f in "${files[@]}"; do
      case "$f" in
        *.conf) _walk "$f" ;;
        *) log_warn "pkg ignored (not .conf): $f" ;;
      esac
    done
  }

  # @post/@pre 登记脚本: 目录 → 其下全部非 .conf 文件; 逐文件/glob → 非 .conf 即脚本
  _do_scripts() {
    local src="$1" target="$2" base="$3" origin="$4" f canon
    local -a files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(
      _expand_target "$target" "$base" ! -name '*.conf')

    if [ "${#files[@]}" -eq 0 ]; then
      log_warn "$src not found: $origin"
      return 0
    fi

    for f in "${files[@]}"; do
      case "$f" in
        *.conf)
          log_warn "$src ignored (package manifest, use '@pkg'): $f"
          ;;
        *)
          canon=$(realpath -m "$f")
          [ -n "${_seen[$canon]:-}" ] && continue
          _seen[$canon]=1
          printf '%s %s\n' "$src" "$canon"
          ;;
      esac
    done
  }

  local f
  for f in "$@"; do
    _walk "$f"
  done
}

# 展开组名列表为成员集合: 支持组嵌套, 防环; 预取所有组名避免逐成员 fork
expand_groups() {
  local -A _seen=() _all_groups=()
  while IFS= read -r g; do
    _all_groups[$g]=1
  done < <(pacman -Sg 2>/dev/null | sed 's/ .*//' | sort -u || true)
  _recurse() {
    local g="$1" m
    [ -n "${_seen[$g]:-}" ] && return 0
    _seen[$g]=1
    while IFS= read -r m || [ -n "$m" ]; do
      [ -n "$m" ] || continue
      if [ -n "${_all_groups[$m]:-}" ]; then
        _recurse "$m"
      else
        printf '%s\n' "$m"
      fi
    done < <(pacman -Sgq "$g" 2>/dev/null || true)
  }
  local g
  for g in "$@"; do
    _recurse "$g"
  done
}

# 自动识别可收拢的包组: 组成员全部已安装（显式或依赖）时导出 *组名
# 未安装的组成员会在 apply 时被补装, 依赖装的成员会转为显式 — 这是导出组的语义
# 开销: 3 次 pacman 调用（组名列表 + 全量"组 成员"对 + 已装包全集）, 检查全在内存完成
detect_groups() {
  local -A members_of=() pkg_groups=() cand=() inst_map=() _seen=()
  local g p
  # 无参数 -Sg 只输出组名; 带上全部组名才输出"组 成员"对
  local -a groups=()
  mapfile -t groups < <(pacman -Sg 2>/dev/null || true)
  while IFS=' ' read -r g p; do
    [ -n "$g" ] && [ -n "$p" ] || continue
    members_of[$g]+=" $p"
    pkg_groups[$p]+=" $g"
  done < <(pacman -Sg "${groups[@]}" 2>/dev/null || true)

  # 候选组 = 已装包（含依赖）所属的组; 官方组不含 AUR 包名, -Qq 无需剔除
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    inst_map[$p]=1
    local -a gs=()
    IFS=' ' read -r -a gs <<<"${pkg_groups[$p]:-}"
    for g in "${gs[@]:-}"; do
      [ -n "$g" ] && cand[$g]=1
    done
  done < <(pacman -Qq 2>/dev/null || true)

  # 内存递归展开组成员（组嵌套时成员可能是组名, 防环）; 全部已装才为真
  _all_installed() {
    local m
    local -a ms=()
    # 全局 IFS 是 \n\t, 成员串须显式按空格拆分
    IFS=' ' read -r -a ms <<<"$1"
    for m in "${ms[@]}"; do
      if [ -n "${members_of[$m]:-}" ]; then
        [ -n "${_seen[$m]:-}" ] && continue
        _seen[$m]=1
        _all_installed "${members_of[$m]}" || return 1
      elif [ -z "${inst_map[$m]:-}" ]; then
        return 1
      fi
    done
    return 0
  }
  for g in "${!cand[@]}"; do
    _seen=()
    if [ -n "${members_of[$g]:-}" ] && _all_installed "${members_of[$g]}"; then
      printf '%s\n' "$g"
    fi
  done
}

load_desired() {
  local src pkg
  # 配置缺失时显式报错, 避免 parse_manifest 静默返回空 → 期望集合为空 → 全部包被判定待移除
  if [ ! -f "$config_file" ]; then
    log_error "config not found: $config_file"
    exit 1
  fi
  # 以包名为键去重; 全局 IFS 是 \n\t, 这里显式按空格切分 "src pkg"
  declare -A pkg_src=()
  declare -A explicit_pkgs=()
  group_only_pkgs=()
  post_scripts=()
  prepare_scripts=()

  while IFS=' ' read -r src pkg; do
    [ -n "$pkg" ] || continue
    # @pre 引入的前置脚本: 不参与包调和, 登记到准备清单
    if [ "$src" = pre ]; then
      prepare_scripts+=("$pkg")
      continue
    fi
    # @post 引入的后置脚本: 不参与包调和, 登记到执行清单
    if [ "$src" = post ]; then
      post_scripts+=("$pkg")
      continue
    fi
    # @group 声明: 展开为成员参与对拍; 组名记录供 sync 保留与导出排除
    if [ "$src" = group ]; then
      desired_groups+=("$pkg")
      local m
      while IFS= read -r m || [ -n "$m" ]; do
        if [ -n "$m" ]; then
          if [ -n "${pkg_src[$m]:-}" ]; then
            # 重复定义时优先级: repo > aur
            if [ "${pkg_src[$m]}" = aur ]; then
              pkg_src[$m]=repo
            fi
          else
            pkg_src[$m]=repo
          fi
        fi
      done < <(expand_groups "$pkg")
      continue
    fi
    explicit_pkgs[$pkg]=1
    if [ -n "${pkg_src[$pkg]:-}" ]; then
      # 重复定义时优先级: repo > aur
      if [ "$src" = repo ] && [ "${pkg_src[$pkg]}" = aur ]; then
        log_warn "$pkg listed in both repo and aur, keeping repo"
        pkg_src[$pkg]=repo
      fi
      continue
    fi
    pkg_src[$pkg]=$src
  done < <(parse_manifest "$config_file")

  # 识别仅由包组引入的包
  local k
  for k in "${!pkg_src[@]}"; do
    if [ -z "${explicit_pkgs[$k]:-}" ]; then
      group_only_pkgs[$k]=1
    fi
  done

  desired_repo=()
  desired_aur=()
  for pkg in "${!pkg_src[@]}"; do
    case "${pkg_src[$pkg]}" in
      aur) desired_aur+=("$pkg") ;;
      *) desired_repo+=("$pkg") ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# 实际状态: 以 pacman 数据库为唯一真相
# ---------------------------------------------------------------------------

load_installed() {
  # -Qe 包含 AUR 包, -Qem 只含 AUR 包; 两者取差即官方源显式包
  # 查询失败（数据库缺失等）按空集处理, 不中断流程
  local -a all_explicit=() foreign_explicit=()
  mapfile -t all_explicit < <(pacman -Qeq 2>/dev/null | sort -u || true)
  mapfile -t foreign_explicit < <(pacman -Qemq 2>/dev/null | sort -u || true)

  inst_repo=()
  inst_aur=("${foreign_explicit[@]}")
  while read -r f; do
    [ -n "$f" ] && inst_repo+=("$f")
  done < <(comm -23 <(printf '%s\n' "${all_explicit[@]:-}") \
                    <(printf '%s\n' "${foreign_explicit[@]:-}"))

  inst_all_map=()
  local p
  while read -r p; do
    [ -n "$p" ] && inst_all_map[$p]=1
  done < <(pacman -Qq 2>/dev/null || true)
}

# comm 要求输入有序; 空数组时 printf 会多出一个空行, 先剔除避免参与比较
print_sorted() {
  printf '%s\n' "$@" | sed '/^$/d' | sort -u
}

compute_diffs() {
  # comm -13: 仅第二文件(期望)有 → 待安装; comm -23: 仅第一文件(已装)有 → 待移除
  local -a raw_added_repo=() raw_added_aur=()
  mapfile -t raw_added_repo < <(comm -13 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${desired_repo[@]:-}"))
  mapfile -t raw_added_aur < <(comm -13 <(print_sorted "${inst_aur[@]:-}") <(print_sorted "${desired_aur[@]:-}"))

  added_repo=()
  local p
  for p in "${raw_added_repo[@]:-}"; do
    [ -n "$p" ] || continue
    if [ -n "${group_only_pkgs[$p]:-}" ] && [ -n "${inst_all_map[$p]:-}" ]; then
      continue
    fi
    added_repo+=("$p")
  done

  added_aur=()
  for p in "${raw_added_aur[@]:-}"; do
    [ -n "$p" ] || continue
    if [ -n "${group_only_pkgs[$p]:-}" ] && [ -n "${inst_all_map[$p]:-}" ]; then
      continue
    fi
    added_aur+=("$p")
  done

  removed_repo=()
  removed_aur=()
  mapfile -t removed_repo < <(comm -23 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${desired_repo[@]:-}"))
  mapfile -t removed_aur < <(comm -23 <(print_sorted "${inst_aur[@]:-}") <(print_sorted "${desired_aur[@]:-}"))
}

# 期望/实际装载并计算差异（apply/diff/status 共用）
load_and_compute() {
  load_desired
  load_installed
  compute_diffs
}

# 待变更包总数; 全 0 即 in sync
pending_total() {
  echo $(( ${#added_repo[@]} + ${#added_aur[@]} + ${#removed_repo[@]} + ${#removed_aur[@]} ))
}

print_diff() {
  local p
  # Legend: green "+" = install, red "-" = remove; "(repo)" = official repos, "(aur)" = AUR
  echo "Legend: green \"+\" = install, red \"-\" = remove; (repo) = official repos, (aur) = AUR"
  # 不用 "${arr[@]:-}": 空数组时它会展开成一个空串元素, 造成空包名假行;
  # compute_diffs 已确保四个数组一定存在, 直接展开即可
  for p in "${added_repo[@]}"; do printf '\033[32m+ %s\033[0m (repo)\n' "$p"; done
  for p in "${added_aur[@]}"; do printf '\033[32m+ %s\033[0m (aur)\n' "$p"; done
  for p in "${removed_repo[@]}"; do printf '\033[31m- %s\033[0m (repo)\n' "$p"; done
  for p in "${removed_aur[@]}"; do printf '\033[31m- %s\033[0m (aur)\n' "$p"; done
}

# ---------------------------------------------------------------------------
# 变更执行
# ---------------------------------------------------------------------------

# 一次 -Syu 完成全系统升级; 非 pacman 后端时同时刷新 AUR 数据库
# 命名 sysupgrade 避免与子命令 apm sync（导出清单）混淆
sysupgrade() {
  if [ "$APM_BACKEND" = pacman ]; then
    sudo pacman -Syu --noconfirm
  else
    run_as_user "$APM_BACKEND" -Syu --noconfirm
  fi
}

# 装前预检: 一次批量查询确认包在对应来源存在, 避免单个坏名字让整批事务失败
verify_pkgs() {
  local src="$1" found p
  shift
  if [ "$src" = repo ]; then
    found=$(LC_ALL=C pacman -Si "$@" 2>/dev/null | sed -n 's/^Name[[:space:]]*: //p') || true
  else
    found=$(run_as_user env LC_ALL=C "$APM_BACKEND" -Si "$@" 2>/dev/null | sed -n 's/^Name[[:space:]]*: //p') || true
  fi
  for p in "$@"; do
    if printf '%s\n' "$found" | grep -qx "$p"; then
      printf '%s\n' "$p"
    elif [ "$src" = repo ]; then
      log_warn "skip $p: not found in configured repos (typo, or belongs to [AUR]/third-party repo)"
    else
      log_warn "skip $p: not found in AUR (removed or renamed upstream)"
    fi
  done
}

# repo/AUR 分两轮: 官方源走 pacman, 不经 AUR helper; --needed 保证幂等
install_repo_round() {
  [ "${#added_repo[@]}" -gt 0 ] || return 0
  local -a ok=()
  mapfile -t ok < <(verify_pkgs repo "${added_repo[@]}")
  [ "${#ok[@]}" -gt 0 ] || return 0
  log_info "installing repo packages: ${ok[*]}"
  sudo pacman -S --noconfirm --needed "${ok[@]}"
}

# AUR 预检: 一次批量经 helper 查询包是否存在（仓库或 AUR）, 过滤上游删除/改名/拼错的包
# AUR 包必须经 helper 安装; backend=pacman 时跳过并记录而非失败, 清单可跨后端使用
install_aur_round() {
  [ "${#added_aur[@]}" -gt 0 ] || return 0
  if [ "$APM_BACKEND" = pacman ]; then
    log_warn "backend=pacman, skipping AUR packages: ${added_aur[*]}"
    return 0
  fi
  ensure_aur_backend || return 1
  local -a ok=()
  mapfile -t ok < <(verify_pkgs aur "${added_aur[@]}")
  [ "${#ok[@]}" -gt 0 ] || return 0
  log_info "installing AUR packages: ${ok[*]}"
  run_as_user "$APM_BACKEND" -S --noconfirm --needed "${ok[@]}"
}

# 确保 AUR 后端可用: 缺失时直接报错, 由用户自行安装（不再自动引导）
ensure_aur_backend() {
  [ "$APM_BACKEND" != pacman ] || return 0
  if command -v "$APM_BACKEND" >/dev/null 2>&1; then
    return 0
  fi
  log_error "AUR helper '$APM_BACKEND' not found, install it first (e.g. 'sudo pacman -S $APM_BACKEND') or set APM_BACKEND=pacman"
  return 1
}

# 安全删除判定: Required By 列表中只要存在"不在本次移除集合内"的包
# （移除后仍存活的依赖者）, 就禁止删除, 防止破坏依赖链
removal_safe() {
  local pkg="$1" remove_set="$2" req r
  # LC_ALL=C 固定 "Required By" 字段名（zh_CN 下该标签是"依赖它"）;
  # 列表为空白分隔; read 补 || [ -n "$r" ] 以处理末行无换行符
  req=$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Required By[[:space:]]*:[[:space:]]*//p')
  if [ -z "$req" ] || [ "$req" = "None" ]; then
    return 0
  fi
  while IFS= read -r r || [ -n "$r" ]; do
    r=$(trim "$r")
    [ -n "$r" ] || continue
    if ! printf '%s\n' "$remove_set" | grep -qx "$r"; then
      return 1
    fi
  done < <(printf '%s\n' "$req" | tr '[:space:]' '\n')
  return 0
}

# 合并待移除列表; ${arr[@]:-} 在空数组时会展开出一个空串参数, sed 剔除避免幻影包名
removed_all() {
  printf '%s\n' "${removed_repo[@]:-}" "${removed_aur[@]:-}" | sed '/^$/d'
}

remove_round() {
  local -a all=() to_remove=()
  mapfile -t all < <(removed_all)
  [ "${#all[@]}" -gt 0 ] || return 0

  local remove_set pkg
  remove_set=$(printf '%s\n' "${all[@]}")
  for pkg in "${all[@]}"; do
    if removal_safe "$pkg" "$remove_set"; then
      to_remove+=("$pkg")
    else
      log_warn "keep $pkg (still required by kept packages)"
    fi
  done

  if [ "${#to_remove[@]}" -gt 0 ]; then
    log_info "removing: ${to_remove[*]}"
    # -Rns: 递归移除无主依赖并删除配置文件
    sudo pacman -Rns --noconfirm "${to_remove[@]}"
  fi
}

# 只执行清单经 @post 声明的脚本（按声明序）, 未声明的不执行;
# 用 source 而非 bash 执行: post 脚本依赖主进程的 $path 等变量;
# 包裹子 shell 防止脚本对环境(PATH/选项/cwd)的修改污染主进程
run_post() {
  local script
  if [ "${#post_scripts[@]}" -eq 0 ]; then
    log_warn "manifest references no post scripts (try '@post post.d/' in apm.conf)"
    return 0
  fi
  for script in "${post_scripts[@]}"; do
    # set +e 保持"中途失败不中断、只看最终状态"的既有语义（子 shell 内）
    # shellcheck disable=SC1090
    if ! ( set +e; source "$script" ); then
      log_warn "$script failed, continuing..."
    fi
  done
}

# 执行 @pre 声明的脚本（安装前前置步骤, 如源配置/密钥导入）;
# 准备步骤系基础环境构建, 失败时立即报错并中断流程, 防止带病继续执行安装
run_prepare() {
  local script
  if [ "${#prepare_scripts[@]}" -eq 0 ]; then
    return 0
  fi
  for script in "${prepare_scripts[@]}"; do
    log_info "running prepare script: $script"
    if ! ( set -e; source "$script" ); then
      log_error "prepare script failed: $script"
      return 1
    fi
  done
}

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------

cmd_apply() {
  parse_opts "$@" || return 1

  acquire_lock
  load_and_compute

  if [ "$(pending_total)" -eq 0 ]; then
    log_info "in sync: repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
    if [ "$opt_scripts" -eq 1 ]; then
      run_post
    fi
    return 0
  fi

  echo "== diff =="
  print_diff

  # 删除确认在变更前完成，拒绝则整体中止
  local -a rem_preview=()
  mapfile -t rem_preview < <(removed_all)
  if [ "${#rem_preview[@]}" -gt 0 ]; then
    # 预览 pacman -Rns 的真实递归闭包（含孤儿依赖级联），而不只是候选计数
    log_info "pacman -Rns 实际将移除（含递归依赖）:"
    pacman -Rns --print "${rem_preview[@]}" 2>/dev/null | sed 's/^/  - /' || true
    if ! confirm "remove ${#rem_preview[@]} package(s)?"; then
      log_error "aborted by user"
      return 1
    fi
  fi

  # 执行顺序: 确认 → 准备(prepare) → upgrade → 装 repo → 装 AUR → 删 → 后置(post)
  if ! run_prepare; then
    log_error "aborted due to prepare script failure"
    return 1
  fi

  local needs_upgrade=0
  [ "${#added_repo[@]}" -gt 0 ] && needs_upgrade=1
  if [ "${#added_aur[@]}" -gt 0 ] && [ "$APM_BACKEND" != pacman ]; then
    needs_upgrade=1
  fi
  if [ "$needs_upgrade" -eq 1 ]; then
    log_info "upgrading system before install"
    sysupgrade
  fi

  install_repo_round
  install_aur_round
  remove_round

  run_post

  log_info "All tasks done"
}

cmd_diff() {
  parse_opts "$@" || return 1
  load_and_compute
  if [ "$(pending_total)" -eq 0 ]; then
    log_info "in sync: repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
  else
    print_diff
  fi
}

cmd_status() {
  parse_opts "$@" || return 1
  load_and_compute
  echo "desired:      repo=${#desired_repo[@]} aur=${#desired_aur[@]}"
  echo "installed:    repo=${#inst_repo[@]} aur=${#inst_aur[@]}"
  echo "pending:      +repo=${#added_repo[@]} +aur=${#added_aur[@]} -repo=${#removed_repo[@]} -aur=${#removed_aur[@]}"
}

cmd_upgrade() {
  parse_opts "$@" || return 1
  acquire_lock
  log_info "upgrading with backend=$APM_BACKEND"
  sysupgrade
}

# 反向 reconcile: 以系统为真相重新生成配置清单（导出, 供迁移/重建清单用）
# 覆盖前确认, --yes 跳过
# @pkg/@post/@pre 与 *组名 行原样保留置顶: 组文件/脚本/组声明是清单的声明性入口, 不能被导出冲掉
cmd_sync() {
  parse_opts "$@" || return 1

  acquire_lock
  load_desired
  load_installed

  local manifest="$config_file"

  # 1. 仅提取 @pkg/@post/@pre 顶级指令（置顶于 [Pacman] 之前）
  local -a directives=()
  if [ -f "$manifest" ]; then
    mapfile -t directives < <(grep -E '^[[:space:]]*@(pkg|post|pre)([[:space:]]|$)' "$manifest" || true)
  fi

  # 2. 提取原清单主文件中已声明的 *组名 列表（置于 [Pacman] 下）
  local -a manifest_groups=()
  if [ -f "$manifest" ]; then
    mapfile -t manifest_groups < <(grep -E '^[[:space:]]*\*[^[:space:]]+' "$manifest" | sed 's/^[[:space:]]*\*//' || true)
  fi

  # 3. 收集由 @pkg 引入的所有子清单中已经涵盖的包及组成员（去重避免导出冲掉子清单）
  local -A inc_pkgs=()
  local -a pkg_directives=()
  if [ -f "$manifest" ]; then
    mapfile -t pkg_directives < <(grep -E '^[[:space:]]*@pkg([[:space:]]|$)' "$manifest" || true)
  fi
  if [ "${#pkg_directives[@]}" -gt 0 ]; then
    local tmp_manifest
    tmp_manifest="$(dirname "$manifest")/.apm_sync_tmp.conf"
    printf '%s\n' "${pkg_directives[@]}" >"$tmp_manifest"
    local src pkg
    while IFS=' ' read -r src pkg; do
      [ -n "$pkg" ] || continue
      if [ "$src" = group ]; then
        local m
        while IFS= read -r m || [ -n "$m" ]; do
          [ -n "$m" ] && inc_pkgs[$m]=1
        done < <(expand_groups "$pkg")
      else
        inc_pkgs[$pkg]=1
      fi
    done < <(parse_manifest "$tmp_manifest")
    rm -f "$tmp_manifest"
  fi

  # 4. 组声明与自动检测组逻辑
  local -a group_members=() detected_groups=()
  local -A detected_map=()
  local g
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    if ! printf '%s\n' "${desired_groups[@]:-}" | grep -qx "$g"; then
      detected_map[$g]=1
    fi
  done < <(detect_groups)
  if [ "${#detected_map[@]}" -gt 0 ]; then
    mapfile -t detected_groups < <(printf '%s\n' "${!detected_map[@]}" | sort)
  fi
  local -a all_groups=("${desired_groups[@]}" "${detected_groups[@]}")
  if [ "${#all_groups[@]}" -gt 0 ]; then
    mapfile -t group_members < <(expand_groups "${all_groups[@]}" | sort -u)
  fi

  # 5. 计算导出包：系统已装包减去（组内包 + @pkg子清单已有包）
  local -a exclude_pkgs=()
  mapfile -t exclude_pkgs < <(printf '%s\n' "${group_members[@]:-}" "${!inc_pkgs[@]}" | sort -u)

  local -a export_repo=() export_aur=()
  mapfile -t export_repo < <(comm -23 <(print_sorted "${inst_repo[@]:-}") <(print_sorted "${exclude_pkgs[@]:-}"))
  mapfile -t export_aur < <(comm -23 <(print_sorted "${inst_aur[@]:-}") <(print_sorted "${exclude_pkgs[@]:-}"))

  if ! confirm "rewrite $manifest: repo=${#export_repo[@]} aur=${#export_aur[@]} group=${#detected_groups[@]}? (@pkg/@post/@pre lines kept, comments replaced)"; then
    log_error "aborted by user"
    return 1
  fi

  # 6. 原子重写 manifest
  local inc g p
  {
    printf '# generated by apm sync - edit freely, run "apm apply" to reconcile\n'
    if [ "${#directives[@]}" -gt 0 ]; then
      for inc in "${directives[@]}"; do printf '%s\n' "$inc"; done
      printf '\n'
    fi
    printf '[Pacman]\n'
    for g in "${manifest_groups[@]}"; do printf '*%s\n' "$g"; done
    for g in "${detected_groups[@]}"; do printf '*%s\n' "$g"; done
    for p in "${export_repo[@]}"; do printf '%s\n' "$p"; done
    printf '\n[AUR]\n'
    for p in "${export_aur[@]}"; do printf '%s\n' "$p"; done
  } >"$manifest.tmp"
  mv "$manifest.tmp" "$manifest"

  log_info "$manifest rewritten: repo=${#export_repo[@]} aur=${#export_aur[@]} group=${#detected_groups[@]}"
}

# 生成清单模板: 默认写 apm.conf; 已存在则拒绝（--force 覆盖）,
# 模板内置注释掉的 @pkg/@post/@pre 候选, 取消注释即启用
cmd_gen() {
  local force=0
  local -a rest=()
  for a in "$@"; do
    case "$a" in
      -f | --force) force=1 ;;
      *) rest+=("$a") ;;
    esac
  done
  parse_opts "${rest[@]}" || return 1

  local manifest="$config_file"
  if [ -f "$manifest" ] && [ "$force" -eq 0 ]; then
    log_error "$manifest already exists (use --force to overwrite)"
    return 1
  fi
  # 生成到自定义路径时父目录可能不存在
  mkdir -p "$(dirname "$manifest")"

  cat >"$manifest" <<'EOF'
# apm 清单 — 期望状态声明; 修改后运行 apm apply 调和到系统
# 语法: [Pacman]/[AUR] 分节 + 每行一个包名; # 注释
# 指令: @pkg 引包清单(.conf) / @pre 前置脚本(安装前) / @post 后置脚本(安装后);
# 支持文件/目录/glob, 相对路径基于本文件所在目录
#
# 包组候选（取消注释即启用, 需先创建对应文件）:
#@pkg apm.d/base.conf
#@pkg apm.d/desktop.conf
# 准备脚本候选（安装前执行, 如源配置/密钥导入）:
#@pre pre.d/
# 后置脚本候选（安装后执行, 服务/用户态配置）:
#@post post.d/
# 包组声明候选: *组名 展开为成员参与对拍（无需创建文件, 组恒为 repo 源）:
#*xorg
#*fcitx5-im

[Pacman]
# 官方源包示例（取消注释即安装）:
#zsh
#git
#htop
#tmux
# 官方源包组示例（*组名 展开为成员参与对拍）:
#*gnome

[AUR]
# AUR 包示例（需 APM_BACKEND 为 yay/paru, 且已配置 archlinuxcn 源）:
#visual-studio-code-bin
#google-chrome
EOF
  log_info "generated $manifest"
}

cmd_run() {
  parse_opts "$@" || return 1
  acquire_lock
  load_desired
  run_post
}

cmd_install() {
  if [ -f "$path/installer.sh" ]; then
    exec "$path/installer.sh" "$@"
  else
    log_error "installer.sh not found in $path"
    return 1
  fi
}

usage() {
  cat <<EOF
apm — declarative Arch package manager

usage:
  apm <command> [options]       (默认: help)

  # 查看与对比
  apm d | diff [-c <path>]                    显示待变更包 (期望 vs 已装)
  apm t | status [-c <path>]                  显示统计摘要

  # 状态调和与清单管理
  apm a | apply [-y] [--scripts] [-c <path>]  调和清单与系统 (先打印 diff)
  apm s | sync [-y] [-c <path>]               导出已装包到清单
  apm g | gen [-f] [-c <path>]                生成清单模板 (拒绝覆盖)

  # 系统运维与脚本
  apm u | update | upgrade                    全系统升级 (repo + aur)
  apm e | exec                                强制执行后置脚本 (@post)
  apm i | install [options]                   Arch Linux 系统全新安装交互引导
  apm h | help | -h | --help                  显示帮助

options:
  -y, --yes       跳过确认 (删除 / 重写清单)
  -c, --config    指定清单路径 (默认: 脚本同目录 apm.conf)
  --scripts       即使 in sync 也执行后置脚本

env:
  APM_BACKEND   pacman | yay | paru (默认: 自动检测, 兜底 yay)
EOF
}

main() {
  local cmd="${1:--h}"
  shift || true
  case "$cmd" in
    # 查看与对比
    d | diff) cmd_diff "$@" ;;
    t | status) cmd_status "$@" ;;

    # 状态调和与清单管理
    a | apply) cmd_apply "$@" ;;
    s | sync) cmd_sync "$@" ;;
    g | gen) cmd_gen "$@" ;;

    # 系统运维与脚本
    u | update | upgrade) cmd_upgrade ;;
    e | exec) cmd_run "$@" ;;
    i | install) cmd_install "$@" ;;
    h | help | -h | --help) usage ;;
    *) usage; return 1 ;;
  esac
}

# main guard: 被 source 时只加载函数（便于单测）, 直接执行才运行
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
