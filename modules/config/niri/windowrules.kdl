// ============================================================================
// 窗口与图层规则 (Window & Layer Rules)
// ============================================================================

// ----------------------------------------------------------------------------
// 全局窗口装饰与聚焦行为
// ----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
    open-focused true
}

// ----------------------------------------------------------------------------
// 终端与开发应用：背景高斯模糊
// ----------------------------------------------------------------------------
window-rule {
    match app-id=r#"^(kitty|alacritty|foot|org\.wezfurlong\.wezterm)$"#
    background-effect {
        blur true
    }
}

// ----------------------------------------------------------------------------
// QuickShell 桌面组件：真实背景模糊与弹层模糊
// 层表面关闭 xray（透视壁纸），OSD/启动器/通知等呈现下层真实内容的毛玻璃；
// bar 弹层（xdg_popup）的客户端协议请求不生效，由 niri 侧强制模糊并统一圆角。
// ----------------------------------------------------------------------------
layer-rule {
    match namespace="^quickshell"
    background-effect {
        xray false
    }
    popups {
        geometry-corner-radius 20
        background-effect {
            blur true
            xray false
        }
    }
}

// ----------------------------------------------------------------------------
// 浮动窗口与系统工具：半透明毛玻璃与尺寸行为
// ----------------------------------------------------------------------------
// 文件选择与保存对话框自动浮动并聚焦
window-rule {
    match title=r#"^(Open [Ff]iles?|打开|Open [Ff]older|Save [Ff]ile|Save [Aa]s)"#
    open-floating true
    open-focused true
}

// 微信图片与视频预览窗口自动浮动
window-rule {
    match app-id=r#"^wechat$"# title=r#"^(预览|图片和视频)$"#
    open-floating true
}